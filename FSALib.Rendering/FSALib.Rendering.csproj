<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>net8.0;net6.0;netstandard2.0;netstandard2.1;net472;</TargetFrameworks>
	  <ImplicitUsings>false</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	  <Title>FSALib.Rendering</Title>
	  <Version>1.3.0.0</Version>
	  <AssemblyVersion>$(Version)</AssemblyVersion>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>
	  <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
	  <Copyright>Venomalia</Copyright>
	  <Description>Bibliotek to render FSA data.</Description>
	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	  <NETFrameworks>|netstandard2.0|net481|net48|net472|NET471|NET47|NET462|NET461|</NETFrameworks>
  </PropertyGroup>
	
	<PropertyGroup Condition="$(NETFrameworks.Contains('|$(TargetFramework)|'))">
		<LangVersion>8.0</LangVersion>
	</PropertyGroup>
	
	<ItemGroup>
	  <PackageReference Include="AuroraLib.Pixel.Formats.Dolphin" Version="0.8.2" />
	</ItemGroup>
	
	<ItemGroup>
	  <ProjectReference Include="..\FSALib\FSALib.csproj" />
	</ItemGroup>

</Project>
